{
  "manifest_version": 3,
  "name": "SoFi Options Extractor",
  "version": "1.0",
  "description": "Auto-extract options data from SoFi for analysis",
  "permissions": ["activeTab", "scripting", "storage", "webRequest"],
  "host_permissions": ["https://*.sofi.com/*", "https://*.invest.sofi.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.sofi.com/*", "https://*.invest.sofi.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SoFi Options Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
